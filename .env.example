PORT=5000
NODE_ENV=development

# Sesuaikan dengan database MySQL Laragon Anda.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_jam_kerja

# Ganti dengan nilai acak rahasia minimal 32 karakter sebelum menjalankan server.
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
